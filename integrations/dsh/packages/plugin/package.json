{
  "name": "@offeru/dsh-plugin",
  "version": "0.1.0",
  "private": true,
  "description": "OfferU dual-face plugin for DeepSeek Harness rc8: host bridge client + browser workbench slots",
  "main": "lib/index.js",
  "type": "module",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  }
}
