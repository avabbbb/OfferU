{
  "name": "offeru-job-collector",
  "version": "0.1.0",
  "private": true,
  "description": "OfferU 岗位采集插件（WXT）- 五平台手动采集 + 购物车同步",
  "scripts": {
    "dev": "wxt",
    "build": "wxt build && node scripts/sync-root-build.mjs",
    "zip": "wxt zip",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build:legacy": "tsc && node scripts/copy-static.mjs",
    "watch:legacy": "tsc --watch"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.270",
    "jsdom": "^29.1.1",
    "playwright": "^1.60.0",
    "typescript": "^5.5.0",
    "vitest": "^5.0.5",
    "wxt": "^0.20.22"
  },
  "overrides": {
    "adm-zip": "^0.6.1",
    "shell-quote": "^1.9.0",
    "tmp": "^0.2.6",
    "uuid": "^11.1.1",
    "esbuild": "^0.28.1"
  }
}
