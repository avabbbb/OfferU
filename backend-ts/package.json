{
  "name": "offeru-backend-ts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx src/server.ts",
    "start": "tsx src/server.ts",
    "cli": "tsx src/cli.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build:web": "npm --prefix ../frontend run build:web",
    "worker:dev": "wrangler dev",
    "worker:dry-run": "wrangler deploy --dry-run",
    "deploy": "npm run build:web && wrangler deploy"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.19",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@offeru/core": "file:../packages/core",
    "fast-png": "^8.0.0",
    "hono": "^4.13.18",
    "jpeg-js": "^0.4.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261115.1",
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^5.0.5",
    "wrangler": "^4.162.0"
  },
  "optionalDependencies": {
    "playwright-core": "^1.65.0"
  }
}
