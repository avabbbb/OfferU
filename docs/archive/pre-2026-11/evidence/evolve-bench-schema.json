{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "offeru-evolve-bench-report/1.0",
  "title": "OfferU-EvolveBench report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "report_schema",
    "suite_id",
    "suite_version",
    "run_id",
    "run_kind",
    "started_at",
    "finished_at",
    "executor",
    "environment",
    "dataset",
    "totals",
    "metrics",
    "safety",
    "cases",
    "limitations",
    "recommended_decision"
  ],
  "properties": {
    "report_schema": { "const": "offeru-evolve-bench-report/1.0" },
    "suite_id": { "const": "offeru-evolve-bench-v1" },
    "suite_version": { "type": "string", "minLength": 1 },
    "run_id": { "type": "string", "minLength": 1 },
    "run_kind": { "enum": ["dev", "feedback", "hidden", "regression"] },
    "started_at": { "type": "string", "format": "date-time" },
    "finished_at": { "type": "string", "format": "date-time" },
    "executor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["agent", "model"],
      "properties": {
        "agent": { "type": "string", "minLength": 1 },
        "model": { "type": "string", "minLength": 1 }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "commit",
        "dirty_files",
        "os",
        "python",
        "node",
        "offeru_cli",
        "harness",
        "provider",
        "provider_model",
        "data_isolation"
      ],
      "properties": {
        "commit": { "type": "string", "minLength": 1 },
        "dirty_files": { "type": "array", "items": { "type": "string" } },
        "os": { "type": "string", "minLength": 1 },
        "python": { "type": "string", "minLength": 1 },
        "node": { "type": "string", "minLength": 1 },
        "offeru_cli": { "type": "string", "minLength": 1 },
        "harness": { "type": "string", "minLength": 1 },
        "provider": { "type": "string", "minLength": 1 },
        "provider_model": { "type": "string", "minLength": 1 },
        "data_isolation": { "enum": ["proven", "not_proven"] }
      }
    },
    "dataset": { "$ref": "#/$defs/dataset" },
    "totals": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pass", "fail", "blocked", "not_run", "invalid"],
      "properties": {
        "pass": { "type": "integer", "minimum": 0 },
        "fail": { "type": "integer", "minimum": 0 },
        "blocked": { "type": "integer", "minimum": 0 },
        "not_run": { "type": "integer", "minimum": 0 },
        "invalid": { "type": "integer", "minimum": 0 }
      }
    },
    "metrics": { "$ref": "#/$defs/metrics" },
    "safety": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "violations", "hard_gate"],
      "properties": {
        "status": { "enum": ["PASS", "FAIL", "NOT_RUN", "BLOCKED", "INVALID"] },
        "violations": { "type": "array", "items": { "type": "string" } },
        "hard_gate": { "const": true }
      }
    },
    "cases": { "type": "array", "items": { "$ref": "#/$defs/case" } },
    "limitations": { "type": "array", "items": { "type": "string" } },
    "recommended_decision": {
      "enum": [
        "stop-for-safety",
        "fix-regression",
        "unblock-environment",
        "run-more-evals",
        "candidate-for-human-review"
      ]
    }
  },
  "$defs": {
    "nullableNumber": { "type": ["number", "null"] },
    "dataset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["split", "dataset_hash", "case_count", "gold_access", "source", "planned_counts"],
      "properties": {
        "split": { "enum": ["dev", "feedback", "hidden", "regression"] },
        "dataset_hash": { "type": "string", "minLength": 1 },
        "case_count": { "type": "integer", "minimum": 0 },
        "gold_access": { "enum": ["public", "runner_only"] },
        "source": { "type": "string", "minLength": 1 },
        "planned_counts": {
          "type": "object",
          "additionalProperties": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "overall_score",
        "pass_at_1",
        "pass_power_3",
        "pass_power_5",
        "profile_auc_plus",
        "profile_auc_minus",
        "retention_rate",
        "negative_transfer_rate",
        "gain_transfer_ratio",
        "brier_score",
        "judge_improvement_spearman",
        "cross_provider_robustness",
        "tokens",
        "tool_calls",
        "latency_p50_ms",
        "latency_p95_ms",
        "manual_corrections"
      ],
      "properties": {
        "overall_score": { "$ref": "#/$defs/nullableNumber" },
        "pass_at_1": { "$ref": "#/$defs/nullableNumber" },
        "pass_power_3": { "$ref": "#/$defs/nullableNumber" },
        "pass_power_5": { "$ref": "#/$defs/nullableNumber" },
        "profile_auc_plus": { "$ref": "#/$defs/nullableNumber" },
        "profile_auc_minus": { "$ref": "#/$defs/nullableNumber" },
        "retention_rate": { "$ref": "#/$defs/nullableNumber" },
        "negative_transfer_rate": { "$ref": "#/$defs/nullableNumber" },
        "gain_transfer_ratio": { "$ref": "#/$defs/nullableNumber" },
        "brier_score": { "$ref": "#/$defs/nullableNumber" },
        "judge_improvement_spearman": { "$ref": "#/$defs/nullableNumber" },
        "cross_provider_robustness": { "$ref": "#/$defs/nullableNumber" },
        "tokens": { "$ref": "#/$defs/nullableNumber" },
        "tool_calls": { "$ref": "#/$defs/nullableNumber" },
        "latency_p50_ms": { "$ref": "#/$defs/nullableNumber" },
        "latency_p95_ms": { "$ref": "#/$defs/nullableNumber" },
        "manual_corrections": { "$ref": "#/$defs/nullableNumber" }
      }
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["case_id", "status", "trials_required", "trials_passed", "trials"],
      "properties": {
        "case_id": { "type": "string", "pattern": "^EVOLVE-[A-Z0-9]+(?:-[A-Z0-9]+)*-[0-9]{3}$" },
        "area": { "type": "string" },
        "split": { "type": "string" },
        "status": { "enum": ["PASS", "FAIL", "BLOCKED", "NOT_RUN", "INVALID"] },
        "trials_required": { "type": ["integer", "null"], "enum": [1, 3, 5, null] },
        "trials_passed": { "type": "integer", "minimum": 0 },
        "trials": { "type": "array", "items": { "$ref": "#/$defs/trial" } }
      }
    },
    "trial": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "trial_id",
        "status",
        "duration_ms",
        "trajectory_evidence",
        "outcome_evidence",
        "failed_assertions",
        "safety_violations",
        "tool_calls",
        "llm_calls",
        "tokens",
        "manual_corrections"
      ],
      "properties": {
        "trial_id": { "type": "string", "minLength": 1 },
        "status": { "enum": ["PASS", "FAIL", "BLOCKED", "NOT_RUN", "INVALID"] },
        "duration_ms": { "type": ["integer", "null"], "minimum": 0 },
        "trajectory_evidence": { "type": "array", "items": { "type": "string" } },
        "outcome_evidence": { "type": "array", "items": { "type": "string" } },
        "failed_assertions": { "type": "array", "items": { "type": "string" } },
        "safety_violations": { "type": "array", "items": { "type": "string" } },
        "tool_calls": { "type": ["integer", "null"], "minimum": 0 },
        "llm_calls": { "type": ["integer", "null"], "minimum": 0 },
        "tokens": { "type": ["integer", "null"], "minimum": 0 },
        "manual_corrections": { "type": ["integer", "null"], "minimum": 0 }
      }
    }
  }
}
