{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "OfferU default capabilities",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "shell:allow-execute",
    "shell:allow-spawn",
    "shell:allow-kill",
    {
      "identifier": "shell:allow-execute",
      "allow": [
        {
          "name": "binaries/backend",
          "sidecar": true
        }
      ]
    }
  ]
}