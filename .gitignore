# =============================================
# OfferU — Git 忽略规则
# =============================================

# ---- 依赖目录 ----
node_modules/
.venv*/
__pycache__/
*.pyc

# ---- 构建输出 ----
backend-rs/target/
frontend/.next/
frontend/.next-dev/
frontend/out/
frontend/dist/
frontend/tsconfig.tsbuildinfo
extension/.output/
extension/.wxt/
extension/chunks/
extension/assets/
extension/content-scripts/
extension/entrypoints/
extension/offscreen/
extension/background.js
extension/manifest.json
extension/popup.html
backend/*.db
*.db
backend/data/
offeru-data/

# ---- 环境配置 ----
.env
.env.local
.env.*.local
backend/.env
backend/config.json

# ---- IDE / 编辑器 ----
.vscode/
.idea/
*.swp
*.swo
*~

# ---- OS 文件 ----
.DS_Store
Thumbs.db
desktop.ini

# ---- 上传目录中的用户文件 ----
backend/uploads/photos/*
!backend/uploads/photos/.gitkeep

# ---- 日志 ----
*.log
npm-debug.log*

# ---- 测试/临时 ----
coverage/
.pytest_cache/
.playwright-mcp/
# 文档默认保持本地；只版本化当前事实链、Eval、归档索引与 Agent 配置。
docs/*
!docs/README.md
!docs/adr/
!docs/adr/**
!docs/agents/
!docs/agents/**
!docs/architecture/
!docs/architecture/**
!docs/evals/
!docs/evals/**
!docs/archive/
!docs/archive/**
# Eval 原始截图/trace 默认只保留本地；正式报告必须包含脱敏后的关键证据。
docs/evals/reports/artifacts/
artifacts/

# ---- 备份文件 ----
*.bak
backup/

# ---- 敏感替换文件 ----
replacements.txt

# ---- 本地敏感讨论文档 ----
docs/产品分歧分析_*.md
md/

# ---- Trae 本地元数据 ----
.trae/
.Trae/

# ---- Claude AI 配置 ----
.claude/

# ---- 本地参考仓库（不入库） ----
references/
reference/
/Niuke/

# ---- Launcher 打包产物 ----
launcher/build/
launcher/dist/
launcher/*.spec
launcher/__pycache__/
/OfferU.exe
/package-lock.json
